# BONSAI Environment Variables
# Copy this file to .env.local and fill in the values.

# --- LLM ---
# Claude API key for LLM pipeline (Extract, Cluster, Constitutional Filter)
ANTHROPIC_API_KEY=

# --- Phase3: Rork Integration ---
# Rork API key for project management and clone operations
RORK_API_KEY=

# --- Phase3: GitHub Connect ---
# GitHub personal access token (scope: repo) for Rork repo management
GITHUB_TOKEN=

# --- Phase3: Blaxel (Phase3-1 以降) ---
# Blaxel API key for sandbox execution
# BLAXEL_API_KEY=

# --- Phase3: Unbound (Phase3 後半) ---
# Unbound API key for runtime constitution governance
# UNBOUND_API_KEY=
